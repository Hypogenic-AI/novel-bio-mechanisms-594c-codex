{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"pwd && source .venv/bin/activate && python - <<'PY'\nimport json\nimport numpy as np\nimport pandas as pd\nfrom scipy import stats\nrng=np.random.default_rng(42)\ns=pd.read_csv('results/assay_summary.csv')\nc=pd.read_csv('results/candidate_features.csv')\ni=pd.read_csv('results/intervention_results.csv')\ndef boot_ci(values, n=10000):\n    values=np.asarray(values, dtype=float)\n    values=values[np.isfinite(values)]\n    if len(values)==0: return [None,None]\n    meds=[]\n    for _ in range(n):\n        meds.append(np.median(rng.choice(values, size=len(values), replace=True)))\n    return [float(np.percentile(meds,2.5)), float(np.percentile(meds,97.5))]\nsummary={\n  'best_sae_abs_spearman_median_ci95': boot_ci(s.best_sae_abs_spearman),\n  'best_raw_abs_spearman_median_ci95': boot_ci(s.best_raw_abs_spearman),\n  'shuffle_p95_abs_spearman_median_ci95': boot_ci(s.shuffled_sae_best_abs_spearman_p95),\n  'sae_minus_raw_median': float(np.median(s.best_sae_abs_spearman-s.best_raw_abs_spearman)),\n  'sae_minus_raw_median_ci95': boot_ci(s.best_sae_abs_spearman-s.best_raw_abs_spearman),\n  'sae_minus_shuffle_p95_median': float(np.median(s.best_sae_abs_spearman-s.shuffled_sae_best_abs_spearman_p95)),\n  'sae_minus_shuffle_p95_median_ci95': boot_ci(s.best_sae_abs_spearman-s.shuffled_sae_best_abs_spearman_p95),\n  'assays_sae_gt_raw': int((s.best_sae_abs_spearman>s.best_raw_abs_spearman).sum()),\n  'assays_sae_gt_shuffle_p95': int((s.best_sae_abs_spearman>s.shuffled_sae_best_abs_spearman_p95).sum()),\n  'candidate_rows': int(len(c)),\n  'low_target_and_swiss_motif_candidates': int(((c.low_target_motif_alignment)&(c.low_swissprot_motif_alignment.fillna(False))).sum()),\n  'intervention_effects': i.to_dict(orient='records'),\n}\nif len(i):\n    summary['intervention_effect_median']=float(np.median(i.intervention_effect_high_minus_low))\n    summary['intervention_effect_median_ci95