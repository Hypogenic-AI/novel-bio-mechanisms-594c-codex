{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && PYTHONPATH=code/interPLM python - <<'PY'\nimport torch\nfrom huggingface_hub import hf_hub_download\nfrom interplm.sae.dictionary import ReLUSAE\nfrom transformers import AutoTokenizer, EsmForMaskedLM\nprint('cuda', torch.cuda.is_available())\npath=hf_hub_download(repo_id='Elana/InterPLM-esm2-8m', filename='layer_4/ae_normalized.pt')\nprint('sae path', path)\nstate=torch.load(path, map_location='cuda' if torch.cuda.is_available() else 'cpu')\nprint('state keys', list(state.keys())[:5])\nprint('encoder shape', tuple(state['encoder.weight'].shape))\nsae=ReLUSAE.from_pretrained(path, device='cuda' if torch.cuda.is_available() else 'cpu').eval()\nprint('sae', sae.activation_dim, sae.dict_size, 'normfactors', sae.has_normalization_factors)\ntok=AutoTokenizer.from_pretrained('facebook/esm2_t6_8M_UR50D')\nmodel=EsmForMaskedLM.from_pretrained('facebook/esm2_t6_8M_UR50D').to('cuda' if torch.cuda.is_available() else 'cpu').eval()\nseq='MRKLSDELLIESYFKATEMNLNRDFIELIENEIKRRSLGHIISV'\ninputs=tok([seq], return_tensors='pt').to(model.device)\nwith torch.no_grad():\n    out=model(**inputs, output_hidden_states=True)\n    h=out.hidden_states[4][0,1:-1]\n    f=sae.encode(h, normalize_features=True)\nprint('hidden', h.shape, 'features', f.shape, 'active', (f>0).float().mean().item(), 'max', f.max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
