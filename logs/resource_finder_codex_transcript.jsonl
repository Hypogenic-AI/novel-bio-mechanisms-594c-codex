{"type":"item.started","item":{"id":"item_155","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nfrom pathlib import Path\nimport json, gzip, itertools, csv\nimport pandas as pd\nimport pyarrow.parquet as pq\n\nsummary = {}\nbase = Path('datasets/proteingym_v1')\nfor cfg_dir in sorted([p for p in base.iterdir() if p.is_dir()]):\n    files = sorted(cfg_dir.glob('*.parquet'))\n    dfs=[]\n    rows=0\n    schema=None\n    sample_records=[]\n    for f in files:\n        table=pq.read_table(f)\n        rows += table.num_rows\n        schema = table.schema\n        if len(sample_records)<5:\n            df=table.slice(0, min(5-len(sample_records), table.num_rows)).to_pandas()\n            sample_records.extend(df.to_dict(orient='records'))\n    sample_dir=cfg_dir/'samples'\n    sample_dir.mkdir(exist_ok=True)\n    with open(sample_dir/'sample_records.json','w') as out:\n        json.dump(sample_records, out, indent=2, default=str)\n    summary[cfg_dir.name]={'files':len(files),'rows':rows,'columns':schema.names if schema else []}\n\n# Swiss-Prot quick count and sample FASTA entries\nsp=Path('datasets/swissprot/uniprot_sprot.fasta.gz')\nrecords=[]; count=0; current=[]\nwith gzip.open(sp,'rt') as fh:\n    for line in fh:\n        if line.startswith('>'):\n            if current:\n                count += 1\n                if len(records)<5: records.append(''.join(current))\n            current=[line]\n        else:\n            if current is not None: current.append(line)\n    if current:\n        count += 1\n        if len(records)<5: records.append(''.join(current))\nPath('datasets/swissprot/samples').mkdir(exist_ok=True)\nPath('datasets/swissprot/samples/sample_sequences.fasta').write_text(''.join(records))\nsummary['swissprot']={'records':count,'file_bytes':sp.stat().st_size}\n\n# PROSITE entry counts\nprosite=Path('datasets/prosite/prosite.dat').read_text(errors='replace')\nprorule=Path('datasets/prosite/prorule.dat').